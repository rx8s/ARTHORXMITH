rules_version = '2';

// ARTHORXMITH Cloud Storage rules.
// Deploy: Firebase Console → Storage → Rules (or `firebase deploy --only storage`).
// Monster artwork is publicly readable (cards render for every player);
// only admins (role checked in Firestore) may upload.
service firebase.storage {
  match /b/{bucket}/o {
    match /monsters/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
