rules_version = '2';

// ARTHORXMITH Firestore security rules.
// Deploy: Firebase Console → Firestore Database → Rules (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Emails allowed to hold the admin role. Keep in sync with
    // ADMIN_EMAILS in js/core/Constants.js.
    function isAdminEmail() {
      return signedIn() &&
        request.auth.token.email in ['rtiix8@gmail.com', 'artit-g@asefa.co.th'];
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Player profiles. Anyone signed in may read (ranking/profile views);
    // only the owner writes, and the role field can never be self-escalated.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid &&
        (request.resource.data.role == 'player' || isAdminEmail());
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Owned card instances, keyed by ownerUid.
    match /cards/{cardId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // One battle deck per player (document id == uid).
    match /decks/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Battle history: append-only, private to the player.
    match /battle_logs/{logId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public leaderboard entries (document id == uid).
    match /ranking/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Game data overrides — readable by all players, writable by admins.
    match /monsters/{monsterId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /skills/{skillId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
